datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Profile {
  id           String        @id @default(uuid())
  fullName     String?       @map("full_name")
  phoneNumber  String?       @map("phone_number")
  role         Role          @default(CUSTOMER)
  createdAt    DateTime      @default(now()) @map("created_at")
  transactions Transaction[]

  @@map("profiles")
}

enum Role {
  CUSTOMER
  ADMIN
}

model Product {
  id             String   @id @default(uuid())
  title          String
  description    String?  @db.Text
  category       String   
  price          Decimal  @db.Decimal(10, 2)
  stockQuantity  Int      @default(0) @map("stock_quantity")
  imageUrls      Json     @map("image_urls") 
  isCustomizable Boolean  @default(false) @map("is_customizable")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("products")
}

model Service {
  id           String   @id @default(uuid())
  serviceName  String   @map("service_name")
  category     String   
  basePrice    Decimal  @default(0.00) @db.Decimal(10, 2) @map("base_price")
  isAvailable  Boolean  @default(true) @map("is_available")
  instructions String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("services")
}

model Transaction {
  id          String          @id @default(uuid())
  profileId   String?         @map("profile_id")
  profile     Profile?        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  type        TransactionType
  status      Status          @default(PENDING)
  totalAmount Decimal         @db.Decimal(10, 2) @map("total_amount")
  metaData    Json?           @map("meta_data") 
  createdAt   DateTime        @default(now()) @map("created_at")

  @@map("transactions")
}

enum TransactionType {
  PRODUCT_PURCHASE
  SERVICE_REQUEST
}

enum Status {
  PENDING
  PROCESSING
  COMPLETED
  CANCELLED
}
model Order {
  id            String   @id @default(uuid())
  customerName  String
  email         String
  phone         String
  paymentMethod String
  paymentStatus String   @default("PENDING")
  totalAmount   Float
  itemsPayload  String   @db.Text // Stores the stringified cart array with all custom fields
  createdAt     DateTime @default(now())
}
model PortfolioItem {
  id          String   @id @default(uuid())
  title       String
  description String?  @db.Text
  category    String   // "graphics", "video", "stickers"
  imageUrlBefore String? // Used exclusively for laptop stickers
  imageUrlAfter  String  // Main image or "After" picture
  videoUrl    String?  // For video editing projects (YouTube/Vimeo/Cloud link)
  createdAt   DateTime @default(now())
}